  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Source": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "entry_id": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "entry_id",
          "url"
        ]
      },
      "Remote": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri",
            "description": "Provider MCP endpoint. Authorize and execute through your client."
          },
          "transport": {
            "type": "string",
            "enum": [
              "streamable-http",
              "sse"
            ]
          }
        },
        "required": [
          "url",
          "transport"
        ]
      },
      "Package": {
        "type": "object",
        "properties": {
          "registry": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "runtime": {
            "type": "string"
          }
        },
        "required": [
          "registry",
          "identifier"
        ]
      },
      "Auth": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Provider authentication hint, not Gist API authentication."
          },
          "credential_names": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "setup_url": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      },
      "OpenAPIConnection": {
        "type": "object",
        "properties": {
          "spec_url": {
            "type": "string",
            "format": "uri"
          },
          "mint_guide_url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "spec_url",
          "mint_guide_url"
        ]
      },
      "Skill": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "source_digest": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "id",
          "title"
        ]
      },
      "Integration": {
        "type": "object",
        "properties": {
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "official": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "mcp",
              "openapi"
            ]
          },
          "service_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          },
          "homepage": {
            "type": "string"
          },
          "repository": {
            "type": "string"
          },
          "remotes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Remote"
            }
          },
          "packages": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Package"
            }
          },
          "openapi": {
            "$ref": "#/components/schemas/OpenAPIConnection"
          },
          "auth": {
            "$ref": "#/components/schemas/Auth"
          },
          "skills": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Skill"
            }
          },
          "server_listing_url": {
            "type": "string"
          },
          "official_evidence_url": {
            "type": "string"
          }
        },
        "required": [
          "source",
          "official",
          "id",
          "kind",
          "service_id",
          "title",
          "description",
          "tags",
          "auth"
        ]
      },
      "IntegrationResults": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Integration"
            }
          },
          "next_cursor": {
            "type": "string"
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "snapshot_revision": {
            "type": "string"
          }
        },
        "required": [
          "items",
          "total",
          "snapshot_revision"
        ]
      },
      "Export": {
        "type": "object",
        "properties": {
          "format": {
            "type": "string",
            "enum": [
              "gist.directory.entry/v1"
            ]
          },
          "record": {
            "$ref": "#/components/schemas/Integration"
          }
        },
        "required": [
          "format",
          "record"
        ]
      },
      "Category": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "slug",
          "name"
        ]
      },
      "App": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "icon_url": {
            "type": "string",
            "description": "Same-origin icon path."
          },
          "background_color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "connector_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "slug",
          "name",
          "description",
          "categories"
        ]
      },
      "AppResults": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/App"
            }
          },
          "categories": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Category"
            }
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "next_offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "categories",
          "total"
        ]
      },
      "APIIndex": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "authentication": {
            "type": "string"
          },
          "openapi_url": {
            "type": "string"
          },
          "docs_url": {
            "type": "string"
          },
          "mcp_url": {
            "type": "string"
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
