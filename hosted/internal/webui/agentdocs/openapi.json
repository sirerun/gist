{
  "openapi": "3.0.3",
  "info": {
    "title": "Gist AI integrations public catalog API",
    "version": "1.0.0",
    "description": "Discover apps, MCP servers and OpenAPI integrations with Gist by Sire Run, Inc. Public discovery is read-only and free, with no sign-in or API key. Provider account authorization and execution belong to Zati or another consuming client. Private workspace artifacts use the separately authenticated registry contract. Capacity is bounded: use small pages, retain cursors, and back off on HTTP 429 or 503.",
    "license": {
      "name": "Apache-2.0",
      "url": "https://github.com/sirerun/gist/blob/main/LICENSE"
    },
    "contact": {
      "name": "Sire Run, Inc.",
      "url": "https://gist.sire.run/contact"
    }
  },
  "servers": [
    {
      "url": "https://gist.sire.run",
      "description": "Public production catalog"
    }
  ],
  "security": [],
  "tags": [
    {
      "name": "Public catalog",
      "description": "Anonymous, read-only discovery and setup metadata."
    }
  ],
  "paths": {
    "/api": {
      "get": {
        "operationId": "getGistAPIIndex",
        "summary": "Discover the Gist public API",
        "description": "Read the public API entry point. No API key, signup or payment is required.",
        "tags": [
          "Public catalog"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Successful public metadata response. No provider connection or execution is performed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/APIIndex"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query; correct the parameters before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin browser request denied; use the site origin or a server-side client.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The requested catalog entry was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed; use GET.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Concurrent capacity is full; back off before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable; retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/directory": {
      "get": {
        "operationId": "searchGistIntegrations",
        "summary": "Find MCP servers and OpenAPI integrations",
        "description": "Search admitted public connection descriptors using word-prefix AND matching. Follow next_cursor unchanged for the same query. Returned metadata does not grant provider access.",
        "tags": [
          "Public catalog"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search text, at most 200 UTF-8 bytes. Start with a small result limit.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "kind",
            "in": "query",
            "description": "Restrict to MCP servers or OpenAPI integrations.",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "mcp",
                "openapi"
              ]
            }
          },
          {
            "name": "tag",
            "in": "query",
            "description": "Filter by an exact catalog tag.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "description": "Opaque next_cursor returned by the preceding matching search.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 2048
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum result count; responses may contain fewer entries to respect the response budget.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful public metadata response. No provider connection or execution is performed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IntegrationResults"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query; correct the parameters before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin browser request denied; use the site origin or a server-side client.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "The requested catalog entry was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed; use GET.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Concurrent capacity is full; back off before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable; retry with backoff.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/directory/item": {
      "get": {
        "operationId": "getGistIntegration",
