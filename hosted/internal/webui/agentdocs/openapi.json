    "/api/directory/apps": {
      "get": {
        "operationId": "searchGistApps",
        "summary": "Browse app inventory",
        "description": "Search discoverable apps by name, slug or description and optionally category. An app listing is not a promise of a working connection; connector_ids name the available descriptors.",
        "tags": [
          "Public catalog"
        ],
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "description": "Search text, at most 200 UTF-8 bytes. Start with a small result limit.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "category",
            "in": "query",
            "description": "Exact category slug from a prior response.",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 200
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based next_offset returned by the preceding page.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Maximum number of app listings to return.",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful public metadata response. No provider connection or execution is performed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppResults"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query; correct the parameters before retrying.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Cross-origin browser request denied; use the site origin or a server-side client.",
            "content": {
              "application/json": {
                "schema": {
