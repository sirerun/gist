                }
              }
            }
          }
        }
      }
    },
    "/api/directory/app": {
      "get": {
        "operationId": "getGistApp",
        "summary": "Inspect an app",
        "description": "Read one app and any explicitly matched connector IDs. Use an ID with getGistIntegration to inspect setup.",
        "tags": [
          "Public catalog"
        ],
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "description": "Exact slug returned by searchGistApps.",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
