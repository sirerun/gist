{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gist.local/contracts/registry/v2/common.schema.json",
  "$defs": {
    "budget": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9223372036854775807
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._~-]+$"
    },
    "descriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "media_type",
        "data"
      ],
      "properties": {
        "encoding": {
          "const": "base64"
        },
        "media_type": {
          "const": "application/zip"
        },
        "data": {
          "type": "string",
          "minLength": 4,
          "maxLength": 13981016,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
