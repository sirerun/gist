{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://gist.local/contracts/registry/v1/manifest.schema.json",
  "type":"object","additionalProperties":false,
  "required":["manifest_version","id","version","name","summary","entrypoint","package_digest","inventory","required_capabilities","runtime_requirements","effects","trust","publication"],
  "properties":{
    "manifest_version":{"const":"1"},"id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._/-]*$"},"version":{"type":"string","minLength":1},"name":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1},"publisher":{"type":"object","additionalProperties":false,"required":["id"],"properties":{"id":{"type":"string","minLength":1},"source_revision":{"type":"string"},"license":{"type":"string"}}},"entrypoint":{"const":"SKILL.md"},"package_digest":{"$ref":"common.schema.json#/$defs/digest"},"inventory":{"$ref":"inventory.schema.json"},"required_capabilities":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["id","contract_version"],"properties":{"id":{"type":"string","minLength":1},"contract_version":{"type":"string","minLength":1},"optional":{"type":"boolean"}}}},"runtime_requirements":{"type":"object","additionalProperties":false,"required":["local_execution"],"properties":{"local_execution":{"type":"boolean"},"filesystem":{"type":"array","items":{"type":"string"}}}},"effects":{"type":"array","items":{"type":"string","minLength":1}},"trust":{"const":"operator_asserted"},"publication":{"type":"object","additionalProperties":false,"required":["status","provenance"],"properties":{"status":{"enum":["draft","screening","approved","published","rejected","revoked","deprecated"]},"provenance":{"enum":["publisher_asserted","derived_unverified"]}}},"taxonomy":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["edition","node_id"],"properties":{"edition":{"type":"string"},"node_id":{"type":"string"}}}},"tags":{"type":"array","items":{"type":"string"}}
  }
}
