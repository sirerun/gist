{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gist.local/contracts/registry/v1/common.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type":"string", "pattern":"^[a-z0-9][a-z0-9._/-]*$"},
    "version": {"type":"string", "pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.-]+)?$"},
    "workspace_id": {"type":"string", "minLength":1},
    "digest": {"$ref":"#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type":"object", "additionalProperties":false, "required":["algorithm","value"], "properties":{"algorithm":{"const":"sha256"},"value":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},
    "timestamp": {"type":"string","format":"date-time"}
  }
}
