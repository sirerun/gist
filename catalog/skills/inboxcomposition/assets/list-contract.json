{
  "id": "mail/messages/list",
  "version": "1.0.0",
  "input_schema": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "maxLength": 1024
      }
    },
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "required": [
      "message_ids",
      "has_more"
    ],
    "properties": {
      "message_ids": {
        "type": "array",
        "maxItems": 20,
        "items": {
          "type": "string",
          "maxLength": 256
        }
      },
      "has_more": {
        "type": "boolean"
      }
    },
    "additionalProperties": false
  },
  "effects": {
    "vocabulary_version": "1",
    "terms": [
      {
        "id": "mail.read",
        "class": "read_only",
        "sensitivity": "sensitive"
      }
    ],
    "aggregate": {
      "class": "read_only",
      "sensitivity": "sensitive"
    }
  },
  "required_scopes": [
    "mail:read"
  ],
  "error_semantics": {
    "not_found": "Report missing message as partial; never invent contents.",
    "denied": "Stop this operation; do not retry without new caller authority.",
    "unavailable": "Report provider failure; caller owns retry policy."
  },
  "forbidden_effects": [
    "mark_read",
    "send",
    "draft",
    "label",
    "delete",
    "attachments",
    "linked_content"
  ]
}
