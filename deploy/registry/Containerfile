# Build with Podman from the repository root.
FROM golang:1.26 AS build
WORKDIR /src
COPY hosted/go.mod hosted/go.sum ./
RUN go mod download
COPY hosted/ ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /out/registry ./cmd/registry

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/registry /registry
COPY hosted/migrations /app/migrations
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/registry"]
